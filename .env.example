# Resend (https://resend.com) — required for contact form emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal attribution dashboard authentication
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
ALLOWED_GOOGLE_DOMAIN=neighborspestsolutions.com

# FieldRoutes server-only credentials (never prefix these with NEXT_PUBLIC_)
FIELDROUTES_AUTH_KEY=replace-with-fieldroutes-key
FIELDROUTES_AUTH_TOKEN=replace-with-fieldroutes-token
FIELDROUTES_BASE_URL=https://neighborspest.pestroutes.com/api
FIELDROUTES_HISTORY_START=2026-01-01

# Vercel creates this when a private Blob store is connected
BLOB_READ_WRITE_TOKEN=replace-with-private-blob-token

# Vercel sends this as the Bearer token for the daily cron request
CRON_SECRET=replace-with-a-separate-long-random-value
